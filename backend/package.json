{
  "name": "blackfish-beta-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "admin": "node scripts/admin.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "prepare:deployment": "node scripts/prepare.mjs",
    "evaluate:reviewed": "node scripts/evaluate-reviewed.mjs evaluation/reviewed-corpus.json",
    "deploy": "wrangler deploy --config wrangler.local.json"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
